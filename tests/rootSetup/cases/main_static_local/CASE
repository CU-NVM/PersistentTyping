# Static locals of main() are roots, like those of any function, keyed
# main()::a and so on (fields main__a, ...); plain
# locals are not (see err_automatic_root). Each is created where it stands,
# when first reached; a nested block is not a DeclContext of its own.
dump: [static-local]
header: pmem_ptr<persistent<int>> main__a;
header: pmem_ptr<persistent<long>> main__b;
header: pmem_ptr<persistent<int>> main__inner;
in main.cpp: [[maybe_unused]] static bool __pers_init_main__a = (pmem_get_or_create<persistent<int>>(__pers_get_root()->main__a, 10), true);
in main.cpp: [[maybe_unused]] static bool __pers_init_main__b = (pmem_get_or_create<persistent<long>>(__pers_get_root()->main__b, 20), true);
in main.cpp: bump(__pers_get_root()->main__a, "a");
out: inner {n+30}
out: a {n+10}
out: b {n+20}
